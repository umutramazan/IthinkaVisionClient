# Bu dosya şablondur. Kopyalayın: cp .env.example .env
# Gerçek .env dosyaları version control'e eklenmez.
#
# Expo yalnızca EXPO_PUBLIC_ önekli değişkenleri istemciye aktarır.
# Ortam ayrımı için .env.development ve .env.production dosyaları kullanılabilir.
#
# Gerçek cihazdan test ederken localhost çalışmaz; bilgisayarın LAN IP'sini yazın.
# Android emülatörü için: http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000

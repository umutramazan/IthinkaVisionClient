{
  "expo": {
    "name": "iThinka Vision",
    "slug": "ithinka-vision",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/ithinka-app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "icon": "./assets/ithinka-app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.ithinka.vision",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/ithinka-app-icon.png",
      "package": "com.ithinka.vision",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Analiz edilecek görseli seçebilmek için galeri erişimi gereklidir.",
          "cameraPermission": "Analiz edilecek fotoğrafı çekebilmek için kamera erişimi gereklidir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "03fde56f-2aeb-41eb-8386-dd22816421c7"
      }
    },
    "owner": "umutramazan"
  }
}

{
  "expo": {
    "name": "iThinka Vision",
    "slug": "ithinka-vision",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/ithinka-app-icon.png",
    "primaryColor": "#FFFFFF",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/ithinka-app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.ithinka.vision",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/ithinka-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ithinka-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.ithinka.vision",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/ithinka-splash-light.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/ithinka-splash-dark.png",
            "backgroundColor": "#171717"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Analiz edilecek görseli seçebilmek için galeri erişimi gereklidir.",
          "cameraPermission": "Analiz edilecek fotoğrafı çekebilmek için kamera erişimi gereklidir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "03fde56f-2aeb-41eb-8386-dd22816421c7"
      }
    },
    "owner": "umutramazan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/03fde56f-2aeb-41eb-8386-dd22816421c7"
    }
  }
}

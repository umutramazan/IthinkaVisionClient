# Bu dosya şablondur. Kopyalayın: cp .env.example .env
# Gerçek .env dosyaları version control'e eklenmez.

# development | production
APP_ENV=development
APP_LOG_LEVEL=INFO

APP_HOST=0.0.0.0
APP_PORT=8000

# Virgülle ayrılmış origin listesi. Production'da "*" kullanmayın.
APP_CORS_ALLOW_ORIGINS=*

# Yükleme limitleri (FAZ 1'de kullanılacak)
APP_MAX_UPLOAD_SIZE_MB=10
APP_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png

# Phase 5 detection runtime
APP_MODEL_PATH=models/best.onnx
APP_MODEL_CONFIDENCE_THRESHOLD=0.25
APP_INFERENCE_MAX_CONCURRENCY=2
